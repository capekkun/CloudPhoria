<connectionStrings>
	<!--
	  Data Source uses "." which means "the default SQL Server instance on
	  this machine" — this works on any PC without editing anything, as long
	  as SQL Server (or SQL Server Express/LocalDB) is installed locally and
	  the CloudPhoria database has been created via the scripts in Database/.

	  If your SQL Server uses a named instance (e.g. installed via SSMS with
	  a name like "SQLEXPRESS"), change "." to ".\SQLEXPRESS" (or whatever
	  your instance is named). See README.md for full setup steps.
	-->
	<add name="CloudPhoria"
	connectionString="Data Source=LAPTOP-NU5EFETS\SQLEXPRESS;Initial Catalog=CloudPhoria;Integrated Security=True;TrustServerCertificate=True"
	providerName="System.Data.SqlClient" />
</connectionStrings>
